# Native artifacts in work/s390x-native were built and verified on Ubuntu 24.04.
# Keep build and runtime on the same distribution/glibc family.
FROM node:24-trixie-slim AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM ubuntu:24.04 AS java-base
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       openjdk-21-jdk-headless ca-certificates curl libstdc++6 libgomp1 zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")" /opt/java
ENV JAVA_HOME=/opt/java
ENV PATH="/opt/java/bin:${PATH}"

FROM java-base AS backend
WORKDIR /build/backend
# Fail early rather than embedding a Mac/amd64 runtime in the mainframe image.
RUN test "$(uname -m)" = s390x
COPY work/s390x-native/onnxruntime-s390x.jar /opt/trajectory-native/onnxruntime-s390x.jar
COPY work/s390x-native/native/libtokenizers.so /opt/trajectory-native/libtokenizers.so
ENV RUST_LIBRARY_PATH=/opt/trajectory-native/libtokenizers.so
COPY backend/gradle/ gradle/
COPY backend/gradlew backend/settings.gradle.kts backend/build.gradle.kts ./
RUN chmod +x gradlew
COPY backend/src/ src/
COPY --from=frontend /build/frontend/dist/ src/main/resources/META-INF/resources/
# Acceptance runs with the exact OS/JDK/native libraries shipped in the final image.
RUN ./gradlew --no-daemon --max-workers=2 -Pkotlin.compiler.execution.strategy=in-process \
      -PortJar=/opt/trajectory-native/onnxruntime-s390x.jar \
      -PrequireS390x=true -Pthreads=2 verifyModel bootJar

FROM java-base AS runtime
RUN useradd --system --uid 10001 --create-home --home-dir /home/app app
WORKDIR /app
COPY --from=backend --chown=10001:10001 /build/backend/build/libs/app.jar /app/app.jar
COPY --from=backend --chown=10001:10001 /opt/trajectory-native/libtokenizers.so /opt/trajectory-native/libtokenizers.so
COPY --from=backend /build/backend/build/reports/trajectory/verification.json /app/verification.json
ENV RUST_LIBRARY_PATH=/opt/trajectory-native/libtokenizers.so
# Leave room outside the Java heap for ONNX Runtime's native allocations.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=50.0 -XX:+ExitOnOutOfMemoryError"
USER 10001
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=90s --retries=6 \
    CMD curl --fail --silent http://127.0.0.1:8080/actuator/health >/dev/null || exit 1
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
